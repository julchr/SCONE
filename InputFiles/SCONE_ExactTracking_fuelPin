type eigenPhysicsPackage;

pop      5000;
cycles   45;
inactive 15;
XSdata ce;
dataType ce;
seed 3;

collisionOperator { neutronCE {type neutronCEstd;} }

transportOperator { type transportOperatorST; cache 1; }

inactiveTally {}

activeTally {
	clerks {
		display (k_eff);
		k_eff {
			type keffAnalogClerk;
		}
	}
}

geometry {
	type geometryStd;
  	boundary (1 1 1 1 1 1);
  	graph {type shrunk;}

  	surfaces {
		boxContainer { id 1; type box; origin (0.0 0.0 0.0); halfwidth (0.75 0.75 0.75); }
  	}

	cells {
   		hostCell {id 1; type simpleCell; surfaces (-1); filltype mat; material water;}
  	}

	meshes { 
		testMesh {
		    id 1;
		    type OpenFOAMMesh;
		    path ./IntegrationTestFiles/Geometry/Meshes/OpenFOAM/FuelPin/;
		    localIds {
		    	assignmentMethod cellZones;
		    }
		    fills (fuel helium cladding water);
		}
	}

	universes {
    	root { id 1; type rootUniverse; border 1; fill u<2>; }
		mesh { id 2; type meshUniverse; origin (0.0 0.0 0.0); rotation (0.0 0.0 0.0); cell 1; mesh 1; fills (fuel); }
  	}

}

nuclearData {
	handles {
    	ce {type aceNeutronDatabase; aceLibrary $SCONE_ACE;}
  	}
  
	materials {
		cladding {
			composition {
				type massFraction;
				density 6.55;
				nuclides {
					40090.03 1.0;
				}
			}
		
		}
		helium {
			composition {
				type atomicDensityFraction;
				density 1.6e-3;
				nuclides {
					2004.03 1.0;
				}
			}
		}

		water {
      		rgb (0 0 139); // Colour of water is dark blue
      		moder { 1001.03 (hh2o.09); }
      		composition {
      			type rawAtomicDensities;
      			nuclides {
      				1001.03    6.700E-002;
      				8016.03    3.350E-002;
      				5010.03    5.560E-006;
      				5011.03    2.224E-005; 
      			}
			}
      	}

    	fuel {
       		composition {
       			type rawAtomicDensities;
       			nuclides {
       				92235.03  1.450E-003;
      				92238.03  4.690E-002;
       			}
			}
      	}
	}
}

